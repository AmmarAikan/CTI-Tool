FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/external

WORKDIR /app

RUN groupadd --system --gid 10001 external \
    && useradd --system --uid 10001 --gid external \
       --home-dir /home/external --create-home external

COPY requirements.external.txt ./requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install --requirement requirements.txt

COPY backend ./backend
COPY contracts ./contracts
COPY config/sources.json \
     config/collection_settings.json \
     config/preprocessing_rules.json \
     config/privacy_rules.json \
     config/dark_web_sources.example.json \
     ./config/

RUN chown -R --no-dereference 0:0 /app/backend /app/contracts /app/config \
    && find /app/backend /app/contracts /app/config -xdev -type d -exec chmod 0755 {} + \
    && find /app/backend /app/contracts /app/config -xdev -type f -exec chmod 0644 {} +

RUN mkdir -p \
      /app/data/external/raw \
      /app/data/external/state \
      /app/data/external/processed \
      /app/data/external/review \
      /app/data/external/exports \
      /app/logs \
    && chown -R 10001:10001 /app/data/external /app/logs

USER 10001:10001

RUN test "$(id -u)" = 10001 \
    && test "$(id -g)" = 10001 \
    && test -r /app/backend/app \
    && test -x /app/backend/app \
    && test -r /app/backend/app/pipeline/ingestion/external \
    && test -x /app/backend/app/pipeline/ingestion/external \
    && test ! -w /app/backend/app \
    && test ! -w /app/backend/app/pipeline/ingestion/external \
    && test -r /app/backend/app/pipeline/ingestion/external/application/dark_web_discovery.py \
    && test ! -w /app/backend/app/pipeline/ingestion/external/application/dark_web_discovery.py \
    && python -c 'from backend.app.pipeline.ingestion.external.application.dark_web_discovery import load_discovery_providers; from backend.app.pipeline.ingestion.external.dark_web_connector import load_dark_web_config'

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "backend.app.pipeline.ingestion.external.integration.local:app", "--host", "0.0.0.0", "--port", "8000"]
