# Copy to .env.vps.local on the VPS. Generate every secret independently.
FEED_PUBLISH_TOKEN=CHANGE_ME_RANDOM_PUBLISH_TOKEN
FEED_READ_TOKEN=CHANGE_ME_RANDOM_READ_TOKEN
FEED_RESPONSE_HMAC_SECRET=CHANGE_ME_RANDOM_FEED_HMAC_SECRET
SENSOR_READ_TOKEN=CHANGE_ME_RANDOM_SENSOR_READ_TOKEN
SENSOR_RESPONSE_HMAC_SECRET=CHANGE_ME_RANDOM_SENSOR_HMAC_SECRET
CURSOR_HMAC_SECRET=CHANGE_ME_RANDOM_CURSOR_SECRET
EXTERNAL_CONTROL_TOKEN=CHANGE_ME_RANDOM_EXTERNAL_CONTROL_TOKEN
JWT_SECRET=CHANGE_ME_RANDOM_SHARED_BACKEND_JWT_SECRET
EXTERNAL_FEED_ID=external-team-feed
SENSOR_ID=cti-vps
SENSOR_READ_GID=31002
MAX_PUBLISH_BYTES=20971520
MAX_SENSOR_BYTES=52428800
MAX_FEED_ITEMS=20000
EXTERNAL_API_DEV_WORKERS=2
EXTERNAL_DARK_WEB_ENABLED=true
EXTERNAL_DARK_WEB_CONFIG_FILE=/etc/cti-platform/dark_web_sources.local.json

# Tor proxy readiness for Dark Web collection.
TOR_PROXY_HOST=tor
TOR_PROXY_PORT=9050

# Optional credentials for VPS-hosted External Sources.
NVD_API_KEY=
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
