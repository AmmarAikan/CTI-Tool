# Copy to .env for Docker Compose. Replace every CHANGE_ME value.
POSTGRES_DB=cti_platform
POSTGRES_USER=cti
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DIONAEA_MAX_LOG_BYTES=52428800

# Optional integrations
NVD_API_KEY=
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_TLS=true

# Collaborator/VPS external JSON feed. Use HTTPS in every non-local environment.
EXTERNAL_FEED_URL=
EXTERNAL_FEED_TOKEN=
EXTERNAL_FEED_HMAC_SECRET=
EXTERNAL_FEED_VERIFY_TLS=true
EXTERNAL_FEED_ALLOW_HTTP=false
EXTERNAL_FEED_REQUIRE_CONTRACT=true
EXTERNAL_FEED_CONNECT_TIMEOUT_SECONDS=5
EXTERNAL_FEED_READ_TIMEOUT_SECONDS=60
EXTERNAL_FEED_MAX_BYTES=20971520
EXTERNAL_FEED_MAX_PAGES=20
EXTERNAL_FEED_PAGE_SIZE=250

# Remote Wazuh Indexer API. Prefer VPN/private networking and a read-only role.
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_TOKEN=
WAZUH_INDEXER_VERIFY_TLS=true
WAZUH_INDEXER_ALLOW_HTTP=false
WAZUH_INDEXER_TIMEOUT_SECONDS=30
WAZUH_INDEXER_BATCH_SIZE=500
WAZUH_INDEXER_NAME=Wazuh VPS
WAZUH_INDEX_PATTERN=wazuh-alerts*
WAZUH_TIMESTAMP_FIELD=timestamp
WAZUH_TIEBREAKER_FIELD=id
# Optional first-run lower bound, for example 2026-08-24T00:00:00Z
WAZUH_INITIAL_SINCE=

# Remote Dionaea JSON sensor API. Keep the sensor API private/VPN-restricted.
DIONAEA_API_URL=
DIONAEA_API_TOKEN=
DIONAEA_API_HMAC_SECRET=
DIONAEA_API_VERIFY_TLS=true
DIONAEA_API_ALLOW_HTTP=false
DIONAEA_API_TIMEOUT_SECONDS=30
DIONAEA_API_MAX_BYTES=20971520
DIONAEA_API_MAX_PAGES=20
DIONAEA_API_PAGE_SIZE=500
DIONAEA_SENSOR_NAME=Dionaea VPS

# Runtime NER quality controls. BERT remains primary; sklearn remains fallback.
NER_MIN_CONFIDENCE=0.50
NER_CHUNK_CHARS=600
NER_CHUNK_OVERLAP_CHARS=100
