# Copy to .env for Docker Compose. Replace every CHANGE_ME value.
POSTGRES_DB=cti_platform
POSTGRES_USER=cti
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DIONAEA_MAX_LOG_BYTES=52428800

# Optional integrations
NVD_API_KEY=
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_TLS=true

# Collaborator/VPS external JSON feed. Use HTTPS in every non-local environment.
EXTERNAL_FEED_URL=
EXTERNAL_FEED_TOKEN=
EXTERNAL_FEED_HMAC_SECRET=
EXTERNAL_FEED_VERIFY_TLS=true
EXTERNAL_FEED_ALLOW_HTTP=false
EXTERNAL_FEED_REQUIRE_CONTRACT=true
EXTERNAL_FEED_CONNECT_TIMEOUT_SECONDS=5
EXTERNAL_FEED_READ_TIMEOUT_SECONDS=60
EXTERNAL_FEED_MAX_BYTES=20971520
EXTERNAL_FEED_MAX_PAGES=20
EXTERNAL_FEED_PAGE_SIZE=250

# Remote Wazuh Indexer API. Prefer VPN/private networking and a read-only role.
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_TOKEN=
WAZUH_INDEXER_VERIFY_TLS=true
WAZUH_INDEXER_ALLOW_HTTP=false
WAZUH_INDEXER_TIMEOUT_SECONDS=30
WAZUH_INDEXER_BATCH_SIZE=500
WAZUH_INDEXER_NAME=Wazuh VPS
WAZUH_INDEX_PATTERN=wazuh-alerts*
WAZUH_TIMESTAMP_FIELD=timestamp
WAZUH_TIEBREAKER_FIELD=id
# Optional first-run lower bound, for example 2026-08-24T00:00:00Z
WAZUH_INITIAL_SINCE=

# Remote Dionaea JSON sensor API. Keep the sensor API private/VPN-restricted.
DIONAEA_API_URL=
DIONAEA_API_TOKEN=
DIONAEA_API_HMAC_SECRET=
DIONAEA_API_VERIFY_TLS=true
DIONAEA_API_ALLOW_HTTP=false
DIONAEA_API_TIMEOUT_SECONDS=30
DIONAEA_API_MAX_BYTES=20971520
DIONAEA_API_MAX_PAGES=20
DIONAEA_API_PAGE_SIZE=500
DIONAEA_SENSOR_NAME=Dionaea VPS

# Lightweight VPS telemetry streams (SSH authentication and gateway access).
# These may use loopback HTTP only when reached through an SSH tunnel.
INTERNAL_SENSOR_API_TOKEN=
INTERNAL_SENSOR_API_HMAC_SECRET=
INTERNAL_SENSOR_VERIFY_TLS=true
INTERNAL_SENSOR_ALLOW_HTTP=false
INTERNAL_SENSOR_TIMEOUT_SECONDS=30
INTERNAL_SENSOR_MAX_BYTES=20971520
INTERNAL_SENSOR_MAX_PAGES=20
INTERNAL_SENSOR_PAGE_SIZE=500
HOST_AUTH_API_URL=
HOST_AUTH_SENSOR_NAME=VPS SSH Authentication
WEB_ACCESS_API_URL=
WEB_ACCESS_SENSOR_NAME=VPS Gateway Access

# Runtime NER quality controls. BERT remains primary; sklearn remains fallback.
NER_MIN_CONFIDENCE=0.50
NER_CHUNK_CHARS=600
NER_CHUNK_OVERLAP_CHARS=100

# External Sources subsystem credentials. Leave blank unless an approved source uses them.
# Optional External Sources credentials. Leave blank unless an approved source uses them.
GITHUB_TOKEN=

# Optional Reddit application-only OAuth credentials. Reddit sources remain disabled
# until access is approved and these values are configured.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Optional Tor proxy for the canonical Phase 8 collector. Both values must be
# set explicitly; the collector intentionally assumes no Tor/Browser port.
TOR_PROXY_HOST=
TOR_PROXY_PORT=

# Phase 11 local internal REST adapter only. Use a strong random value and do
# not expose the development adapter outside the local machine.
EXTERNAL_API_TOKEN=
EXTERNAL_API_ROLES=operator
EXTERNAL_API_DEV_WORKERS=2
# Development only. Swagger/OpenAPI remain disabled unless this is exactly true.
EXTERNAL_API_DOCS_ENABLED=false
