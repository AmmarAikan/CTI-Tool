{
  "schema_version": "1.0",
  "rules_version": "1.0",
  "policy": {
    "ambiguous_action": "review",
    "preserve_cti_indicators": true,
    "log_detected_values": false,
    "redact_high_confidence_secrets": true,
    "redact_high_confidence_personal_data": true
  },
  "redaction_placeholders": {
    "phone_number": "[REDACTED:phone_number]",
    "possible_api_token": "[REDACTED:possible_api_token]",
    "private_key": "[REDACTED:private_key]"
  }
}
