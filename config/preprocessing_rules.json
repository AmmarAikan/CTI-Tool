{
  "schema_version": "1.0",
  "rules_version": "1.1",
  "unicode_normalization": "NFC",
  "preserve_fenced_code_blocks": true,
  "trailing_boilerplate_min_content_chars": 200,
  "trailing_boilerplate_start_patterns": [
    "(?i)^recent posts?:?$",
    "(?i)^related (?:articles?|posts?|stories|content):?$",
    "(?i)^recommended (?:articles?|posts?|stories|reading):?$",
    "(?i)^want more\\?\\s*(?:go )?back to (?:the )?(?:index|home(?:page)?).*$",
    "(?i)^(?:subscribe|sign up) (?:for|to) .*(?:newsletter|updates).*$",
    "(?i)^more from (?:this|the) (?:site|blog|author).*$"
  ],
  "boilerplate_patterns": [
    "(?i)^advertisement$",
    "(?i)^sponsored content$",
    "(?i)share this article.*$",
    "(?i)share on (twitter|facebook|linkedin|reddit)( \\| share on (twitter|facebook|linkedin|reddit))*",
    "(?i)subscribe to our newsletter.*$",
    "(?i)sign up for our newsletter.*$",
    "(?i)follow us on (twitter|facebook|linkedin|instagram).*$",
    "(?i)^comments? \\(\\d+\\)$",
    "(?i)^\\d+ comments?$",
    "(?i)this (site|website) uses cookies.*$",
    "(?i)accept (all )?cookies.*$",
    "(?i)^related (articles?|posts?):?$",
    "(?i)^read more:?$",
    "(?i)^continue reading:?$",
    "(?i)all rights reserved\\.?$",
    "(?i)^copyright \\d{4}.*$",
    "(?i)^tags?:\\s*.*$",
    "(?i)^categories?:\\s*.*$",
    "(?i)^\\s*\\|\\s*$"
  ]
}
