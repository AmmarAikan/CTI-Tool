POSTGRES_USER=cti_external_test
POSTGRES_PASSWORD=synthetic-external-test-database-password
JWT_SECRET=synthetic-external-test-jwt-secret-at-least-32-characters
BOOTSTRAP_ADMIN_USERNAME=external_test_admin
BOOTSTRAP_ADMIN_PASSWORD=synthetic-external-test-admin-password
EXTERNAL_API_TOKEN=synthetic-external-test-control-token
DARK_WEB_DISCOVERY_CONFIG_PATH=./config/dark_web_discovery_providers.external-test.json
